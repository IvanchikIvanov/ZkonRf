# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Без @ — для корректного return_url ЮKassa (https://t.me/<username>)
TELEGRAM_BOT_USERNAME=

# OpenAI
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
TTS_PROVIDER=chatgpt  # Варианты: chatgpt или elevenlabs
MAX_TOKENS=2000
TEMPERATURE=0.7
# Прокси для OpenAI только если нужен, иначе оставь пустым: OPENAI_PROXY=
OPENAI_PROXY=
CONFIRM_INTENT_FIRST=true

# Grok (обязательно для генерации ответов)
GROK_API_KEY=your_grok_key_here
GROK_MODEL=grok-beta
GROK_PROXY=

# ElevenLabs (для голоса девушки)
ELEVENLABS_API_KEY=your_elevenlabs_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here  # ID голоса девушки из ElevenLabs
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.75
MAX_TEXT_LENGTH=5000

# Conversation context
CONTEXT_PROMPT_MESSAGES=30
CONTEXT_SCAN_MESSAGES=200
CONTEXT_MAX_CONTENT_LENGTH=4000

# Payment - ЮKassa (оплата картой)
YOOKASSA_SHOP_ID=your_shop_id_here
YOOKASSA_SECRET_KEY=your_secret_key_here
YOOKASSA_TEST_MODE=true
# Пока бот запущен: незавершённые payment:* в Redis → проверка в API ЮKassa (сек). 0 = автоактивация по карте выключена.
YOOKASSA_POLL_INTERVAL_SECONDS=120

# Payment - Telegram Stars (не требует дополнительных ключей, используется TELEGRAM_BOT_TOKEN)

# Payment - Настройки
FREE_REQUESTS_PER_DAY=3  # Количество бесплатных запросов в день
# Цены подписки (Telegram Stars)
SUBSCRIPTION_PRICE_STARS_1MONTH=100  # Цена подписки в Telegram Stars за 1 месяц
SUBSCRIPTION_PRICE_STARS_3MONTHS=200  # Цена подписки в Telegram Stars за 3 месяца
SUBSCRIPTION_PRICE_STARS_1YEAR=900  # Цена подписки в Telegram Stars за 1 год
# Цены подписки (ЮKassa, рубли)
SUBSCRIPTION_PRICE_YOOKASSA_1MONTH=100  # Цена подписки в рублях через ЮKassa за 1 месяц
SUBSCRIPTION_PRICE_YOOKASSA_3MONTHS=200  # Цена подписки в рублях через ЮKassa за 3 месяца
SUBSCRIPTION_PRICE_YOOKASSA_1YEAR=900  # Цена подписки в рублях через ЮKassa за 1 год

# Payment - Crypto / EVM
CRYPTO_ENABLED_NETWORKS=ethereum,bsc  # Список включенных сетей через запятую (ethereum, bsc)
CRYPTO_MASTER_WALLET=  # Адрес кошелька для приема платежей (опционально)

# Whitelist
USER_WHITELIST=  # Список ID пользователей с бесплатным доступом через запятую (например: "123456,789012")

# --- Пути и SQLite (история пользователей / контекст рядом с DATABASE_PATH) ---
DATABASE_PATH=/app/data/embeddings

# --- Redis (кеш, лимиты, payment:* для ЮKassa) ---
# Локальный сервер (PM2 без Docker), одна строка URL, без комментария после значения:
REDIS_URL=redis://127.0.0.1:6379/0
# Если REDIS_URL пустой, используются REDIS_HOST + REDIS_PORT (+ пароль при необходимости)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_CACHE_TTL=3600

# --- Векторный поиск ---
# pgvector — нужен PostgreSQL с расширением vector; chroma — только файлы на диске (см. chromadb в requirements)
VECTOR_BACKEND=pgvector

# --- PostgreSQL + pgvector (при VECTOR_BACKEND=pgvector) ---
# Системные пакеты (Debian/Ubuntu, пример): apt install postgresql postgresql-contrib
# Расширение vector: apt search pgvector → postgresql-NN-pgvector под версию Postgres
# Создание БД (пример): sudo -u postgres psql -c "CREATE USER zakonrff WITH PASSWORD 'смени';" и CREATE DATABASE zakonrff OWNER zakonrff;
# Формат URL (пароль без спецсимволов или URL-encode: @ # / : → %40 %23 %2F %3A):
DATABASE_URL=postgresql://zakonrff:zakonrff@127.0.0.1:5432/zakonrff
# Если DATABASE_URL пустой, собирается из полей ниже (для Docker хост часто postgres):
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=zakonrff
POSTGRES_USER=zakonrff
POSTGRES_PASSWORD=zakonrff
PGVECTOR_TABLE=codex_embeddings
# Должно совпадать с моделью эмбеддингов (text-embedding-3-large → 3072)
EMBEDDING_DIMENSIONS=3072
# Railway/managed Postgres можно задать только через переменную окружения DATABASE_URL в панели

# Logging
LOG_LEVEL=INFO
LOG_PATH=/app/logs

# Docker
WORKER_COUNT=2

